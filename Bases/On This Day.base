formulas:
  created_date: file.ctime.toString().slice(0, 10)
properties:
  file.name:
    displayName: Entry
  note.categories:
    displayName: Categories
  file.ctime:
    displayName: Created
  note.tags:
    displayName: Tags
views:
  - type: table
    name: On This Day
    filters:
      and:
        - file.ctime.toString().contains(this.file.name.slice(4))
        - '!file.fullname.containsAny("png", "zip")'
        - file.name != this.file.name
    order:
      - formula.created_date
      - file.name
    sort:
      - property: formula.created_date
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      formula.created_date: 153
      file.name: 558
  - type: table
    name: home-view
    filters:
      and:
        - file.ctime == today()
